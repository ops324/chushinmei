NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 確認メール/パスワードリセット等のリンク生成に使う、信頼できる本番サイトURL。
# Host ヘッダ偽装によるリンク汚染を防ぐため、本番では必須（末尾スラッシュなし）。
# 例: https://chushinmei.example.com  （ローカルは未設定で http://localhost:3000 にフォールバック）
NEXT_PUBLIC_SITE_URL=https://your-production-domain

# （任意）エラーモニタリング Sentry の DSN。未設定なら Sentry は完全に無効。
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# ソースマップを Sentry にアップロードする場合のみ（任意・本番）:
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=your-auth-token
